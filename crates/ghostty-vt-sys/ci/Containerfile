# Builds libghostty-vt from the signed release tarballs. Zig lives only in
# this image; nothing else in the repo needs it.
FROM docker.io/library/debian:forky-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl xz-utils minisign \
 && rm -rf /var/lib/apt/lists/*
ARG ZIG_VERSION=0.17.1
ARG ZIG_SHA256=3581863e3cbcfd0fce0efc682ce7e9e93da96668a977791d356a26d2a7e9b17a
RUN curl -fsSLo /tmp/zig.tar.xz https://ziglang.org/download/${ZIG_VERSION}/zig-x86_64-linux-${ZIG_VERSION}.tar.xz \
 && echo "${ZIG_SHA256}  /tmp/zig.tar.xz" | sha256sum -c - \
 && mkdir /opt/zig && tar -xJf /tmp/zig.tar.xz -C /opt/zig --strip-components=1 \
 && rm /tmp/zig.tar.xz
ENV PATH=/opt/zig:$PATH
