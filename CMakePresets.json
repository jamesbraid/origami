{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux",
      "inherits": "base",
      "displayName": "Linux x86-64 product",
      "cacheVariables": {
        "PRODUCT_PLATFORM": "linux"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos",
      "inherits": "base",
      "displayName": "macOS arm64 product",
      "cacheVariables": {
        "PRODUCT_PLATFORM": "macos"
      },
      "environment": {
        "MACOSX_DEPLOYMENT_TARGET": "15.0"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows-cross",
      "inherits": "base",
      "displayName": "Windows x86-64 product (Linux MinGW cross build)",
      "cacheVariables": {
        "PRODUCT_PLATFORM": "windows",
        "PRODUCT_RUST_TARGET": "x86_64-pc-windows-gnu",
        "PRODUCT_CROSS_PREFIX": "x86_64-w64-mingw32-"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux",
      "configurePreset": "linux"
    },
    {
      "name": "macos",
      "configurePreset": "macos"
    },
    {
      "name": "windows-cross",
      "configurePreset": "windows-cross"
    }
  ],
  "testPresets": [
    {
      "name": "linux",
      "configurePreset": "linux",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos",
      "configurePreset": "macos",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-cross",
      "configurePreset": "windows-cross",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "packagePresets": [
    {
      "name": "linux",
      "configurePreset": "linux"
    },
    {
      "name": "macos",
      "configurePreset": "macos"
    },
    {
      "name": "windows-cross",
      "configurePreset": "windows-cross"
    }
  ]
}
