<Application x:Class="Origami.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Indigo accent from the UX design, light and dark. Chrome stays native. -->
            <Color x:Key="SystemAccentColor">#4A52C4</Color>
            <Color x:Key="SystemAccentColorLight2">#7C83F2</Color>
            <Color x:Key="SystemAccentColorDark1">#3F46A8</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
