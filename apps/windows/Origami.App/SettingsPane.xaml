<UserControl x:Class="Origami.App.SettingsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock x:Name="PrefsTitle" Style="{ThemeResource TitleTextBlockStyle}"/>
            <TextBox x:Name="RootBox" Header="Machine library folder" PlaceholderText="C:\Users\you\Origami"
                     AutomationProperties.AutomationId="prefs.root"/>
            <RadioButtons x:Name="ModeButtons" AutomationProperties.AutomationId="prefs.pointer">
                <x:String>Follow my mouse</x:String>
                <x:String>Capture on click</x:String>
            </RadioButtons>
            <TextBlock Text="Release a captured pointer with Ctrl+Alt." Opacity="0.7"/>
            <ToggleSwitch x:Name="ConfirmSwitch" Header="Ask before quitting with machines running"
                          AutomationProperties.AutomationId="prefs.confirmquit"/>
            <TextBlock x:Name="DownloadedTitle" Style="{ThemeResource SubtitleTextBlockStyle}"/>
            <StackPanel x:Name="DownloadedList" Spacing="8" AutomationProperties.AutomationId="prefs.downloaded"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SaveButton" Content="Save" Style="{ThemeResource AccentButtonStyle}"
                        AutomationProperties.AutomationId="prefs.save"/>
                <Button x:Name="CloseButton" Content="Close" AutomationProperties.AutomationId="prefs.close"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
