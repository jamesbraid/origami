<Window x:Class="Origami.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Origami.App"
        Title="Origami">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <MenuBar x:Name="Menus" Grid.Row="0"/>

        <CommandBar x:Name="Toolbar" Grid.Row="1" DefaultLabelPosition="Right" IsOpen="False"
                    HorizontalAlignment="Stretch" Background="Transparent">
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Origami" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border x:Name="PillBorder" CornerRadius="9" Padding="8,1" Background="Gray" VerticalAlignment="Center">
                        <TextBlock x:Name="PillText" Text="" Foreground="White" FontSize="12"
                                   AutomationProperties.AutomationId="status.pill"/>
                    </Border>
                </StackPanel>
            </CommandBar.Content>
            <AppBarButton x:Name="StartButton" Icon="Play" Label="Start"
                          AutomationProperties.AutomationId="cmd.start" ToolTipService.ToolTip="Start"/>
            <AppBarButton x:Name="PowerOffButton" Icon="Stop" Label="Power Off"
                          AutomationProperties.AutomationId="cmd.poweroff" ToolTipService.ToolTip="Power Off"/>
            <AppBarSeparator/>
            <AppBarButton x:Name="PauseButton" Icon="Pause" Label="Pause"
                          AutomationProperties.AutomationId="cmd.pause" ToolTipService.ToolTip="Pause or resume the machine"/>
            <AppBarButton x:Name="ConsoleButton" Icon="Message" Label="Console"
                          AutomationProperties.AutomationId="cmd.console" ToolTipService.ToolTip="Open the machine's serial console"/>
            <AppBarSeparator/>
            <AppBarToggleButton x:Name="PointerButton" Icon="TouchPointer" Label="Follow"
                                AutomationProperties.AutomationId="cmd.pointermode"
                                ToolTipService.ToolTip="Pointer mode: Follow my mouse or Capture on click"/>
            <AppBarButton x:Name="SettingsButton" Icon="Setting" Label="Settings"
                          AutomationProperties.AutomationId="cmd.settings" ToolTipService.ToolTip="Settings"/>
        </CommandBar>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LibraryColumn" Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tabs: a 34 pt bar of 26 pt tabs, always shown. -->
            <Grid x:Name="TabBar" Grid.Column="1" Grid.Row="0" Height="{StaticResource Size.TabBarHeight}"
                  Background="{ThemeResource LayerFillColorDefaultBrush}" AutomationProperties.AutomationId="tabs">
                <StackPanel x:Name="TabStrip" Orientation="Horizontal" Spacing="4" Padding="6,4,6,4"/>
            </Grid>

            <ListView x:Name="Library" Grid.Column="0" Grid.RowSpan="2" SelectionMode="Single"
                      AutomationProperties.AutomationId="library" AutomationProperties.Name="Library"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"/>

            <Grid x:Name="Stage" Grid.Column="1" Grid.Row="1">
                <Border x:Name="Tint" Visibility="Collapsed" IsHitTestVisible="False"/>

                <!-- Stopped: the hero with Start. -->
                <StackPanel x:Name="HeroPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <Image x:Name="HeroImage" Width="240" Height="180" Stretch="Uniform" AutomationProperties.AutomationId="hero.image"/>
                    <Rectangle x:Name="HeroBand" Height="6" Width="260" RadiusX="3" RadiusY="3"/>
                    <TextBlock x:Name="HeroName" Style="{ThemeResource TitleTextBlockStyle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="HeroDetail" Opacity="0.7" HorizontalAlignment="Center"/>
                    <StackPanel x:Name="Cards" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ExitNote" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Center"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed"
                               AutomationProperties.AutomationId="hero.exitnote"/>
                    <Button x:Name="HeroStart" Content="Start" HorizontalAlignment="Center" Style="{ThemeResource AccentButtonStyle}"
                            AutomationProperties.AutomationId="hero.start" MinWidth="120"/>
                </StackPanel>

                <!-- No machines yet. -->
                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed">
                    <local:CubeHost x:Name="EmptyCube" Width="140" Height="140" AutomationProperties.AccessibilityView="Raw"/>
                    <TextBlock x:Name="EmptyTitle" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyHint" Opacity="0.7" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Starting: the live cube on granite, then the screen. -->
                <Grid x:Name="StartingPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <local:CubeHost x:Name="StartCube" Grid.Row="0"/>
                    <StackPanel Grid.Row="1" Spacing="2" Padding="0,10,0,12" HorizontalAlignment="Center">
                        <TextBlock Text="Starting up the system…" Style="{ThemeResource SubtitleTextBlockStyle}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="StageText" Opacity="0.7" HorizontalAlignment="Center"
                                   AutomationProperties.AutomationId="start.stage"/>
                    </StackPanel>
                </Grid>

                <local:DisplayView x:Name="Display" Visibility="Collapsed"/>

                <local:SettingsPane x:Name="Settings" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Padding="12,4" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="StatusText" FontSize="12" Opacity="0.8" VerticalAlignment="Center" AutomationProperties.AutomationId="status.text"/>
                <HyperlinkButton x:Name="ShowShot" Content="Show in Explorer" FontSize="12" Padding="4,0" Visibility="Collapsed"
                                 AutomationProperties.AutomationId="status.showshot"/>
            </StackPanel>
            <TextBlock x:Name="PointerStatus" FontSize="12" Opacity="0.8" HorizontalAlignment="Right"
                       AutomationProperties.AutomationId="status.pointer"/>
        </Grid>
    </Grid>
</Window>
