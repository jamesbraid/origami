<UserControl x:Class="Origami.App.DisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <!-- The surround stands in for granite. The picture itself is a child window over the bezel
         (the core renders into an HWND), so XAML cannot draw on top of it. -->
    <Grid x:Name="Surround" Background="#16161C" AutomationProperties.AutomationId="display.surround"
          AutomationProperties.Name="Machine screen">
        <Border x:Name="Bezel" HorizontalAlignment="Left" VerticalAlignment="Top"
                BorderThickness="2" BorderBrush="#5A5A66"/>
    </Grid>
</UserControl>
