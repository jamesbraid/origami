<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Origami.App</RootNamespace>
    <AssemblyName>Origami</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged and self-contained: no MSIX, no framework package install, no admin. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Origami.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- The default build links the core's fake engine; -p:Qemu=true builds against the QEMU engine's bindings. -->
  <PropertyGroup Condition="'$(Qemu)' != 'true'">
    <DefineConstants>$(DefineConstants);ORIGAMI_FAKE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <ProjectReference Include="../Origami.Logic/Origami.Logic.csproj" />
  </ItemGroup>
  <!-- Generated/origami_ffi.cs (uniffi-bindgen-cs output, made in CI) is compiled by the default globs. -->
  <!-- The shared stills the app shows: the library row (34 pt, light or dark), the hero, and the manifest that names them. -->
  <ItemGroup>
    <Content Include="../../../resources/identity/stills/manifest.json" Link="identity/stills/manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../resources/identity/stills/**/34-*@2x.png;../../../resources/identity/stills/**/hero@2x.png"
             Link="identity/stills/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The tile the screen's surround repeats. -->
  <ItemGroup>
    <Content Include="../../../resources/identity/granite-tile.png" Link="identity/granite-tile.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The licence About prints. -->
  <ItemGroup>
    <Content Include="../../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The icon again as a content file: the window's own icon is set from it at run time. -->
  <ItemGroup>
    <Content Include="Origami.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The core's library and the fallback presenter, cross-built from Linux with mingw into native-out/. -->
  <ItemGroup>
    <None Include="native-out/*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
