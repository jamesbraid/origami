#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pillow"]
# ///
"""Regenerate the app screenshots in docs/images/app/: one fixed, named set per platform.
`pull` takes the release set from GitHub; the other commands make one platform's."""
import argparse, io, json, os, pathlib, re, shutil, subprocess, sys, tempfile

from PIL import Image, ImageChops

ROOT = pathlib.Path(__file__).resolve().parent.parent
CI = ROOT / "crates" / "origami-gtk" / "ci"
OUT = ROOT / "docs" / "images" / "app"
BASELINES = ROOT / "tests" / "screenshots"
CACHE = ROOT / ".cache"  # ignored by git: downloads land here, never in /tmp
XVFB_SCREEN = "1440x960"
GITHUB_REPO = "jamesbraid/origami"

# The names docs/app.md and CHANGELOG.md use. Add a picture here and in the page that shows it.
SETS = {
    "linux": ["linux-library", "linux-engine", "linux-new-machine", "linux-starting", "linux-running", "linux-paused", "linux-cpu-panel",
              "linux-diagnostics", "linux-console", "linux-settings", "linux-about", "linux-acknowledgements", "linux-licences",
              "linux-install-assistant", "linux-ready-disk", "linux-network"],
    "cli": ["cli-machines", "cli-create", "cli-run"],
    "windows": ["windows-running", "windows-cpu-panel", "windows-diagnostics", "windows-acknowledgements", "windows-licences",
                "windows-install-assistant", "windows-ready-disk", "windows-network"],
    "macos": ["macos-library", "macos-new-machine", "macos-running", "macos-cpu-panel", "macos-diagnostics", "macos-about", "macos-acknowledgements", "macos-licences",
              "macos-install-assistant", "macos-ready-disk", "macos-network"],
}
# The main window with a running machine, per app: what `compare` holds against a stored image.
RUNNING = {"linux": "linux-running", "windows": "windows-running", "macos": "macos-running"}
# A pixel is wrong when any channel differs by more than DIFF; the picture fails when more than BAD of its pixels are wrong.
DIFF, BAD = 32, 0.15


def run(*cmd, **kw):
    print("+", " ".join(map(str, cmd)), flush=True)
    subprocess.run(list(map(str, cmd)), check=True, **kw)


def save(src: pathlib.Path, name: str):
    """Re-encode one picture into docs/images/app/NAME.png: no metadata, lossless. A palette is used only when it reproduces every pixel."""
    OUT.mkdir(parents=True, exist_ok=True)
    im = Image.open(src).convert("RGB")
    buf = io.BytesIO()
    im.save(buf, "PNG", optimize=True)
    best = buf.getvalue()
    if im.getcolors(256) is not None:
        q = im.convert("P", palette=Image.Palette.ADAPTIVE, colors=256)
        buf = io.BytesIO()
        q.save(buf, "PNG", optimize=True)
        if len(buf.getvalue()) < len(best) and q.convert("RGB").tobytes() == im.tobytes():
            best = buf.getvalue()
    (OUT / f"{name}.png").write_bytes(best)
    print(f"{name}.png  {im.width}x{im.height}  {len(best) // 1024} KiB")


def collect(folder: pathlib.Path, platform: str):
    missing = [n for n in SETS[platform] if not (folder / f"{n}.png").is_file()]
    if missing:
        sys.exit(f"{platform}: no picture for {', '.join(missing)} in {folder}")
    for n in SETS[platform]:
        save(folder / f"{n}.png", n)


def scratch(a) -> pathlib.Path:
    if not a.scratch:
        sys.exit("--scratch DIR is required: a folder for the Cargo target, the runtime and the outputs (not /tmp)")
    s = pathlib.Path(a.scratch).resolve()
    for d in ("ctx", "cargo", "target", "cache", "work", "out"):
        (s / d).mkdir(parents=True, exist_ok=True)
    return s


def linux(a):
    s = scratch(a)
    env = dict(os.environ, SHOTS_ONLY="1", XVFB_SCREEN=XVFB_SCREEN, NEUTRAL_LIB="1")
    if a.gpu is not None:
        env["GPU"] = f"gpu={a.gpu}"
    run("sh", CI / "linux.sh", s, "docs", env=env)
    collect(s / "out" / "docs", "linux")


def cli(a):
    s = scratch(a)
    if not (s / "target" / "release" / "origami").is_file():
        sys.exit("no built origami in SCRATCH: run `tools/screenshots linux` first")
    dest = s / "out" / "cli"
    shutil.rmtree(dest, ignore_errors=True)
    dest.mkdir(parents=True)
    run("podman", "run", "--rm", "--network", "host", "--memory", "8g",
        "-v", f"{s}:{s}", "-v", f"{ROOT / 'tools'}:/tools:ro",
        "-e", f"ORIGAMI_BIN={s}/target/release/origami", "-e", f"WORK={s}/work/cli",
        "-e", f"ORIGAMI_RUNTIME_DIR={s}/rt/libexec/origami", "-e", f"ORIGAMI_CACHE_DIR={s}/cache",
        "localhost/app-linux-run:1", "sh", "/tools/screenshots-cli.sh", dest)
    collect(dest, "cli")


def windows(a):
    collect(pathlib.Path(a.src), "windows")


def pull(a):
    """Download the screenshots workflow's artifacts and collect every set."""
    repo = ["--repo", a.repo]
    run_id = a.run
    if not run_id:
        listing = subprocess.run(["gh", "run", "list", *repo, "--workflow", "screenshots.yml", "--status", "success", "--limit", "1",
                                  "--json", "databaseId", "--jq", ".[0].databaseId"], check=True, capture_output=True, text=True)
        run_id = listing.stdout.strip()
        if not run_id:
            sys.exit("no successful screenshots run found: start the workflow first (Actions, screenshots, Run workflow)")
    CACHE.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=getattr(a, "tmp", None) or CACHE) as t:
        run("gh", "run", "download", run_id, *repo, "--dir", t,
            "-n", "screenshots-linux", "-n", "screenshots-windows", "-n", "screenshots-macos")
        for artifact, platforms in (("screenshots-linux", ("linux", "cli")), ("screenshots-windows", ("windows",)), ("screenshots-macos", ("macos",))):
            for platform in platforms:
                collect(pathlib.Path(t) / artifact, platform)
        parity(argparse.Namespace(src=t))


def differences(names: dict) -> list:
    """What differs between the names each app's self-test wrote (platform -> its parity JSON). Windows shows Settings
    as one scrolling page, so its section names need only be among the other apps' tab names."""
    out = []
    # Method only shows for a machine that offers an automatic install, and the apps photograph different machines.
    names = {p: {**got, "install_steps": [s for s in got.get("install_steps", []) if s != "Method"]} for p, got in names.items()}
    for key in ("sidebar_heading", "new_machine_fields", "install_steps"):
        for platform, got in names.items():
            if got.get(key) != names["linux"].get(key):
                out.append(f"{key}: {platform} has {got.get(key)!r}, linux has {names['linux'].get(key)!r}")
    for key in ("dialog_titles", "toolbar_tooltips"):
        for platform, got in names.items():
            if got.get(key) != names["linux"].get(key):
                out.append(f"{key}: {platform} has {got.get(key)!r}, linux has {names['linux'].get(key)!r}")
    # The version differs between builds, not between apps: compare its shape.
    shape = lambda lines: [re.sub(r"\d+", "#", t) for t in lines]
    for platform, got in names.items():
        if shape(got.get("about", [])) != shape(names["linux"].get("about", [])):
            out.append(f"about: {platform} has {got.get('about')!r}, linux has {names['linux'].get('about')!r}")
    if names["macos"].get("settings_tabs") != names["linux"].get("settings_tabs"):
        out.append(f"settings_tabs: macos has {names['macos'].get('settings_tabs')!r}, linux has {names['linux'].get('settings_tabs')!r}")
    extra = [t for t in names["windows"].get("settings_tabs", []) if t not in names["linux"].get("settings_tabs", [])]
    if extra:
        out.append(f"settings_tabs: windows has {extra!r}, which linux does not")
    for platform, got in names.items():
        for key in ("sidebar_heading", "settings_tabs", "new_machine_fields", "install_steps", "about", "dialog_titles", "toolbar_tooltips"):
            if not got.get(key):
                out.append(f"{key}: {platform} wrote none")
    return out


def parity(a):
    """Fail when the three apps name the sidebar, the Settings tabs, the New Machine fields or the install steps differently."""
    found = {}
    for platform in ("linux", "macos", "windows"):
        hits = sorted(pathlib.Path(a.src).rglob(f"{platform}-parity.json"))
        if not hits:
            sys.exit(f"no {platform}-parity.json under {a.src}")
        found[platform] = json.loads(hits[0].read_text())
    problems = differences(found)
    for p in problems:
        print(p)
    print("the apps name these the same" if not problems else f"{len(problems)} difference(s)")
    sys.exit(1 if problems else 0)


def judge(got: Image.Image, want: Image.Image):
    """(fraction of pixels that differ by more than DIFF, a diff picture), or None when the sizes differ."""
    if got.size != want.size:
        return None
    a, b = got.convert("RGB"), want.convert("RGB")
    bands = [c.point(lambda v: 255 if v > DIFF else 0) for c in ImageChops.difference(a, b).split()]
    wrong = ImageChops.lighter(ImageChops.lighter(bands[0], bands[1]), bands[2])
    bad = wrong.histogram()[255] / (got.width * got.height)
    return bad, Image.composite(Image.new("RGB", got.size, (255, 0, 0)), b, wrong)


def compare(a):
    """Hold each app's main-window picture in --from against tests/screenshots; exit 1 on a mismatch."""
    src = pathlib.Path(a.src)
    failed = False
    for platform in a.platform or RUNNING:
        name = RUNNING[platform]
        base = BASELINES / f"{name}.png"
        if not (src / f"{name}.png").is_file() or not base.is_file():
            print(f"{name}: missing {'picture' if not (src / f'{name}.png').is_file() else 'baseline'}")
            failed = True
            continue
        got = Image.open(src / f"{name}.png")
        r = judge(got, Image.open(base))
        if r is None:
            print(f"{name}: size {got.size}, baseline {Image.open(base).size}")
            failed = True
        elif r[0] > a.bad:
            r[1].save(src / f"{name}.diff.png")
            print(f"{name}: {r[0]:.2%} of pixels differ (limit {a.bad:.2%}); diff in {name}.diff.png")
            failed = True
        else:
            print(f"{name}: {r[0]:.2%} of pixels differ (limit {a.bad:.2%})")
    sys.exit(1 if failed else 0)


def baseline(a):
    """Store the screenshots workflow's main-window pictures, from its artifacts, as the known-good ones."""
    global OUT
    OUT = BASELINES
    repo = ["--repo", a.repo]
    CACHE.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=getattr(a, "tmp", None) or CACHE) as t:
        run("gh", "run", "download", a.run, *repo, "--dir", t, "-n", "screenshots-linux", "-n", "screenshots-windows", "-n", "screenshots-macos")
        for artifact, platform in (("screenshots-linux", "linux"), ("screenshots-windows", "windows"), ("screenshots-macos", "macos")):
            save(pathlib.Path(t) / artifact / f"{RUNNING[platform]}.png", RUNNING[platform])


def macos(a):
    src = pathlib.Path(a.src) if a.src else None
    if src is None:
        if sys.platform != "darwin":
            sys.exit("macos: run this on a Mac, or pass --from the folder `OrigamiApp --docs-shots` wrote")
        src = pathlib.Path(a.scratch).resolve() / "macos-shots" if a.scratch else ROOT / "target" / "macos-shots"
        run("zsh", ROOT / "apps" / "macos" / "screenshots.sh", src)
    collect(src, "macos")


HELP = {
    "pull": "download the screenshots workflow's artifacts (GitHub, via gh) and collect every set",
    "linux": "build the GTK app in the CI container and run the docs scenario (lavapipe, or --gpu N)",
    "cli": "render origami command transcripts to PNG (run linux first)",
    "windows": "collect the unzipped screenshots-windows artifact",
    "compare": "hold each app's main-window picture against tests/screenshots, within a tolerance",
    "baseline": "store a screenshots workflow run's main-window pictures as the known-good ones",
    "macos": "on a Mac build and render the pictures; or collect a folder with --from",
    "parity": "check the three apps name the sidebar, Settings tabs, New Machine fields and install steps alike",
}


def main():
    p = argparse.ArgumentParser(description=__doc__)
    sub = p.add_subparsers(dest="cmd", required=True)
    for name in ("linux", "cli"):
        c = sub.add_parser(name, help=HELP[name])
        c.add_argument("--scratch")
        if name == "linux":
            c.add_argument("--gpu", type=int, help="run on this NVIDIA device instead of lavapipe")
    c = sub.add_parser("pull", help=HELP["pull"])
    c.add_argument("--tmp", help="where to download the artifacts; default .cache/ in the repository")
    c.add_argument("--run", help="a workflow run id (default: the latest successful one)")
    c.add_argument("--repo", default=GITHUB_REPO, help="GitHub OWNER/NAME (origin is Forgejo); default %(default)s")
    c = sub.add_parser("compare", help=HELP["compare"])
    c.add_argument("--from", dest="src", required=True, help="a folder holding the pictures: linux-running.png and so on")
    c.add_argument("--platform", action="append", choices=sorted(RUNNING), help="only this app (repeatable)")
    c.add_argument("--bad", type=float, default=BAD, help="the fraction of pixels that may differ; default %(default)s")
    c = sub.add_parser("baseline", help=HELP["baseline"])
    c.add_argument("--tmp", help="where to download the artifacts; default .cache/ in the repository")
    c.add_argument("--run", required=True, help="a screenshots workflow run id")
    c.add_argument("--repo", default=GITHUB_REPO, help="GitHub OWNER/NAME; default %(default)s")
    c = sub.add_parser("parity", help=HELP["parity"])
    c.add_argument("--from", dest="src", required=True, help="a folder holding the three apps' *-parity.json files, at any depth")
    c = sub.add_parser("windows", help=HELP["windows"])
    c.add_argument("--from", dest="src", required=True, help="the unzipped screenshots-windows artifact")
    c = sub.add_parser("macos", help=HELP["macos"])
    c.add_argument("--from", dest="src", help="the folder OrigamiApp --docs-shots wrote, or the unzipped screenshots-macos artifact")
    c.add_argument("--scratch")
    a = p.parse_args()
    {"linux": linux, "cli": cli, "windows": windows, "macos": macos, "pull": pull, "compare": compare, "baseline": baseline, "parity": parity}[a.cmd](a)


if __name__ == "__main__":
    main()
