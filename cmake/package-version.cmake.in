# Read tags at packaging time, including tags created after configuration.
execute_process(
  COMMAND "@GIT_EXECUTABLE@" --no-optional-locks -C "@CMAKE_SOURCE_DIR@"
    describe --tags --always --match "v[0-9]*"
  OUTPUT_VARIABLE version
  OUTPUT_STRIP_TRAILING_WHITESPACE
  ERROR_VARIABLE version_error
  RESULT_VARIABLE version_result)
if(NOT version_result EQUAL 0 OR version STREQUAL "")
  message(FATAL_ERROR "Could not determine package version from Git: ${version_error}")
endif()
string(REGEX REPLACE "^v" "" CPACK_PACKAGE_VERSION "${version}")
